{
  "name": "@webnativellc/simple-plist",
  "author": "Joe Wollard",
  "license": "MIT",
  "homepage": "https://github.com/damiant/simple-plist",
  "repository": {
    "type": "git",
    "url": "https://github.com/damiant/simple-plist"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "version": "2.1.2",
  "description": "A wrapper utility for interacting with plist data.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "./dist"
  ],
  "types": "./dist/index.d.ts",
  "keywords": [
    "plist",
    "binary",
    "bplist",
    "xml"
  ],
  "scripts": {
    "build": "tsup",
    "clean:build": "rimraf dist",
    "clean": "rimraf __tests__/write-test* coverage",
    "prepare": "husky install",
    "pretest": "npm run clean",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "bplist-creator": "0.1.1",
    "bplist-parser": "0.3.2",
    "husky": "^7.0.4",
    "lint-staged": "^11.2.6",
    "npm-run-all": "^4.1.5",
    "plist": "^5.0.0",
    "prettier": "^2.7.1",
    "rimraf": "6.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "yarn prettier --write"
  }
}
